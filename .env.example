# Required: Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Required for emailing the PDF: Resend API key (resend.com) and a sender on a verified domain
RESEND_API_KEY=
EMAIL_FROM="MEST Africa <ai-for-smes@meltwater.org>"
# Optional: BCC a MEST inbox on every plan (lead tracking)
EMAIL_BCC=

# Optional: POST each submission (lead data + plan summary) to a webhook
# e.g. Zapier / Make / Google Apps Script that appends to a Google Sheet or Airtable
LEADS_WEBHOOK_URL=

# Optional: max plan requests per IP per hour (default 5)
RATE_LIMIT_PER_HOUR=5
