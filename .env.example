# Required: Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Email delivery: choose ONE option.
# Option A (no DNS changes): a Gmail / Google Workspace account + app password
# (myaccount.google.com → Security → 2-Step Verification → App passwords)
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Option B: Resend (resend.com), sending domain must be verified in Resend
RESEND_API_KEY=
# Sender shown to recipients (with Gmail it must be SMTP_USER or one of its aliases)
EMAIL_FROM="MEST Africa <ai-for-smes@meltwater.org>"
# Optional: BCC a MEST inbox on every plan (lead tracking)
EMAIL_BCC=

# Optional: POST each submission (lead data + plan summary) to a webhook
# e.g. Zapier / Make / Google Apps Script that appends to a Google Sheet or Airtable
LEADS_WEBHOOK_URL=

# Optional: max plan requests per IP per hour (default 5)
RATE_LIMIT_PER_HOUR=5

# Certificates (Google Drive). A Google Cloud service account with Viewer access
# to the certificate sheet and/or folder.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service account JSON (keep the \n sequences)
GOOGLE_PRIVATE_KEY=
# Option 1: Google Sheet with "Email" and certificate link columns (e.g. Autocrat's "Merged Doc URL")
CERT_SHEET_ID=
# CERT_SHEET_RANGE=Sheet1
# Option 2: Drive folder where each file name contains the attendee's email
CERT_FOLDER_ID=
